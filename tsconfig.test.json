{
  // Typecheck de los tests. `tsconfig.json` los excluye para no meterlos en
  // `dist` (arrastrarían `vitest` al runtime de producción), pero excluirlos del
  // typecheck los dejarían sin comprobar: aquí se revisan sin emitir nada.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
